{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "budgets.schema.json",
  "title": "Budget and tiered cap rules",
  "type": "object",
  "required": ["base_amount_usd", "budget_tiers", "weekly_rollover_reserve_cap_usd"],
  "additionalProperties": true,
  "properties": {
    "base_amount_usd": { "type": "number", "minimum": 0 },
    "high_multiplier_threshold": { "type": "number", "minimum": 0 },
    "weekly_rollover_reserve_cap_usd": { "type": "number", "minimum": 0 },
    "monthly_cash_allocation_usd": { "type": "number", "minimum": 0 },
    "risk_guard": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "monthly_cash_allocation_usd": { "type": "number", "minimum": 0 },
        "kill_switch_7d_deploy_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "rolling_burn_window_days": { "type": "integer", "minimum": 1 },
        "kill_switch_window_days": { "type": "integer", "minimum": 1 },
        "cap_multiplier_when_engaged": { "type": "number", "minimum": 0 },
        "deployment_stream": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "budget_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "daily_cap_usd", "weekly_cap_usd"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "enum": ["normal", "elevated", "high_volatility", "stress"] },
          "daily_cap_usd": { "type": "number", "minimum": 0 },
          "weekly_cap_usd": { "type": "number", "minimum": 0 },
          "requires_rollover_reserve": { "type": "boolean" },
          "select_when": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "selection_rule": { "type": "string" },
    "allocation_priority": { "type": "string" },
    "order_rules": { "type": "object" },
    "hard_limits": { "type": "string" }
  }
}
