{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "budgets.schema.json",
  "title": "Budget and tiered cap rules",
  "type": "object",
  "required": [
    "base_amount_usd",
    "base_amount_below_close_usd",
    "high_multiplier_threshold",
    "budget_tiers",
    "weekly_rollover_reserve_cap_usd",
    "circuit_breakers"
  ],
  "additionalProperties": true,
  "properties": {
    "base_amount_usd": { "type": "number", "exclusiveMinimum": 0 },
    "base_amount_below_close_usd": { "type": "number", "exclusiveMinimum": 0 },
    "high_multiplier_threshold": { "type": "number", "exclusiveMinimum": 0 },
    "weekly_rollover_reserve_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
    "monthly_cash_allocation_usd": { "type": "number", "minimum": 0 },
    "circuit_breakers": {
      "type": "object",
      "required": ["max_per_order_usd", "max_consecutive_placement_failures"],
      "additionalProperties": true,
      "properties": {
        "max_per_order_usd": { "type": "number", "exclusiveMinimum": 0 },
        "whole_share_max_per_order_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Per-order ceiling for the whole-share accumulation path only (near_close_dca.StrategyConfig.whole_share_max_per_order_usd, added 2026-08-24). Authorizes exactly ONE share that max_per_order_usd cannot fit -- a whole-share ticker has no smaller purchasable unit -- and never enlarges a multi-share fire. Must not be below max_per_order_usd."
        },
        "max_consecutive_placement_failures": {
          "type": "integer",
          "minimum": 1,
          "description": "How many placements may fail back to back before a live batch stops attempting the remainder (dca_runner.MAX_CONSECUTIVE_PLACEMENT_FAILURES and MorningConfig.max_consecutive_placement_failures, added 2026-08-24). A single ticker's rejection is isolated and never halts the batch; only a consecutive run does. 1 restores the previous halt-on-first-rejection behavior. REQUIRED: dca_runner reads it at import time with no fallback, so a budgets.json omitting it would raise KeyError the moment the runner is imported (Codex review, PR #786: 'Require the new breaker setting in the schema')."
        }
      }
    },
    "risk_guard": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "monthly_cash_allocation_usd": { "type": "number", "minimum": 0 },
        "kill_switch_7d_deploy_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "description": { "type": "string" }
      }
    },
    "budget_tiers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        { "contains": { "properties": { "name": { "const": "normal" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "elevated" } }, "required": ["name"] } },
        {
          "contains": {
            "properties": { "name": { "const": "high_volatility" } },
            "required": ["name"]
          }
        },
        { "contains": { "properties": { "name": { "const": "stress" } }, "required": ["name"] } }
      ],
      "items": {
        "type": "object",
        "required": ["name", "daily_cap_usd", "weekly_cap_usd"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "enum": ["normal", "elevated", "high_volatility", "stress"] },
          "daily_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
          "weekly_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
          "requires_rollover_reserve": { "type": "boolean" },
          "select_when": { "type": "string" },
          "escalate_above_planned_spend_usd": { "type": "number", "exclusiveMinimum": 0 },
          "escalate_above_high_multiplier_signals": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        },
        "if": {
          "properties": { "name": { "const": "stress" } },
          "required": ["name"]
        },
        "then": {
          "properties": { "requires_rollover_reserve": { "const": true } },
          "required": ["requires_rollover_reserve"]
        },
        "else": {
          "properties": { "requires_rollover_reserve": { "const": false } },
          "required": ["escalate_above_planned_spend_usd", "escalate_above_high_multiplier_signals"]
        }
      }
    },
    "selection_rule": { "type": "string" },
    "allocation_priority": { "type": "string" },
    "order_rules": { "type": "object" },
    "hard_limits": { "type": "string" }
  }
}
