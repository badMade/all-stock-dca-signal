{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot-status signal settings (config/slot_status.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "branch", "remote"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "enabled": {"type": "boolean"},
    "branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "remote": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
  }
}
