{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run_state.schema.json",
  "title": "Graded DCA same-day run state",
  "description": "Standardized state file written by the live graded DCA task (ce16ba6b) each trading day. No secrets.",
  "type": "object",
  "required": ["schema_version", "run_date_et", "broker_account", "status", "orders", "budget"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "run_date_et": { "type": "string", "format": "date", "description": "Trading day in America/New_York." },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "broker_account": { "type": "string", "const": "robinhood:562057042" },
    "dry_run": { "type": "boolean" },
    "status": { "type": "string", "enum": ["success", "partial", "skipped", "error"] },
    "trigger_gate_passed": { "type": "boolean" },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "action", "drop_pct", "multiplier", "dollar_amount"],
        "additionalProperties": true,
        "properties": {
          "ticker": { "type": "string" },
          "action": { "type": "string", "enum": ["BUY", "SKIP"] },
          "drop_pct": { "type": "number" },
          "multiplier": { "type": "number", "enum": [0, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5] },
          "dollar_amount": { "type": "number", "minimum": 0 },
          "time_in_force": { "type": "string", "enum": ["gfd"] },
          "order_type": { "type": "string", "enum": ["market"] },
          "review_passed": { "type": "boolean" },
          "broker_order_id": { "type": ["string", "null"] },
          "skip_reason": { "type": ["string", "null"] }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["daily_base_cap_usd", "hard_daily_max_usd", "weekly_hard_cap_usd", "spent_today_usd"],
      "additionalProperties": true,
      "properties": {
        "daily_base_cap_usd": { "type": "number" },
        "hard_daily_max_usd": { "type": "number" },
        "weekly_hard_cap_usd": { "type": "number" },
        "carry_forward_reserve_usd": { "type": "number" },
        "spent_today_usd": { "type": "number" },
        "week_spent_usd": { "type": "number" }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
