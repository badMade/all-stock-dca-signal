{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event-triggered backup settings (config/backup_dispatch.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "to", "check_after_minutes"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "mode": {"type": "string", "enum": ["shadow", "live"]},
    "to": {"type": "string", "const": "computer@perplexity.com"},
    "check_after_minutes": {"type": "integer", "minimum": 5, "maximum": 30}
  }
}
