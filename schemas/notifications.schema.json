{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "notifications.schema.json",
  "title": "Notification routing",
  "type": "object",
  "required": ["channels"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "channels": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "email": {
          "type": "object",
          "required": ["enabled", "address"],
          "properties": {
            "enabled": { "type": "boolean" },
            "scope": { "type": "string" },
            "note": { "type": "string" },
            "address": { "const": "${DCA_ALERT_EMAIL_ADDRESS}" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "scope": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "routing": { "type": "object" }
  }
}
