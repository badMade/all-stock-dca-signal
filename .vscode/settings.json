{
  "python.analysis.extraPaths": [
    "${workspaceFolder}/scripts",
    "${workspaceFolder}/ml-forecaster",
    "${workspaceFolder}/ticker-advisor",
    "${workspaceFolder}/production-safe-agent-loop",
    "${workspaceFolder}/wondrous-octopus"
  ],
  "python.analysis.ignore": [
    "**/.git/**",
    "**/.venv/**"
  ],
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.venv/**": true
  },
  "files.exclude": {
    "**/.git": true
  },
  "python.testing.pytestArgs": [
    "tests",
    "scripts/tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
