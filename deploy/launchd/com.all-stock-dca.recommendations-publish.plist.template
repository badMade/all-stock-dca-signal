<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.all-stock-dca.recommendations-publish</string>
  <!-- Mirrors today's plan-first sets to the `recommendations` branch (scripts/snapshot_cycle.py publish), so the
       Perplexity backups' cloud fallback (the published_rec plan source and the published classify input) can read them.
       Runs HERE, not in the courier session, because a scheduled Claude session holds no GitHub credentials and its
       push failed every cycle (2026-10-26: the branch was a 404 all day). git uses your normal credential helper.
       A failed push exits 2 and raises a macOS notification; an unchanged set is not re-pushed. Started through
       the checkout's venv Python, like the watchdog, because macOS privacy protection (TCC) grants ~/Documents
       access per binary. -->
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_REPO_PATH/.venv/bin/python</string>
    <string>-m</string>
    <string>scripts.snapshot_cycle</string>
    <string>publish</string>
    <string>--notify</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPO_PATH</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- The SAME root the courier writes the recommendation store under (<root>/recommendations/<day>/). -->
    <key>DCA_CRON_TRACKING_ROOT</key><string>REPLACE_WITH_CRON_TRACKING_ROOT</string>
    <!-- git must be on PATH for the push. -->
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Every 5 minutes, the courier's own cadence. Outside the session there is no new set, so it prints UNCHANGED
       (or NONE before the day's first set) and pushes nothing. -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/dca-recommendations-publish.log</string>
  <key>StandardErrorPath</key><string>/tmp/dca-recommendations-publish.log</string>
</dict>
</plist>
