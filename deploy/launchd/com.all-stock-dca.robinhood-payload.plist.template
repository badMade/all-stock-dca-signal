<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.all-stock-dca.robinhood-payload</string>
  <key>ProgramArguments</key>
  <!-- Started through the checkout's venv Python, not /bin/bash directly: macOS privacy protection (TCC)
       grants ~/Documents access per binary, and a launchd agent running /bin/bash on a script under
       ~/Documents fails with "Operation not permitted" (exit 126). The venv Python is the binary the
       ticker-update agent already runs from this checkout, and a child process inherits its access.
       auto: build the payload for the slot whose decision time passed 1-14 minutes ago. -->
  <array>
    <string>REPLACE_WITH_REPO_PATH/.venv/bin/python</string>
    <string>-c</string>
    <string>import subprocess, sys; sys.exit(subprocess.call(["/bin/bash", sys.argv[1], "auto"]))</string>
    <string>REPLACE_WITH_REPO_PATH/deploy/launchd/robinhood_payload.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DCA_REPO</key><string>REPLACE_WITH_REPO_PATH</string>
    <!-- Must match what the Claude sessions use, or the file lands where no slot looks. -->
    <key>DCA_CRON_TRACKING_ROOT</key><string>REPLACE_WITH_CRON_TRACKING_ROOT</string>
    <!-- Absolute path from `command -v codex`; launchd's PATH does not include ~/.local/bin. -->
    <key>DCA_CODEX_BIN</key><string>REPLACE_WITH_CODEX_PATH</string>
    <!-- Overall build deadline, seconds from the start of the fetch (2026-11-02). A healthy build takes 3-6 minutes; the
         11-02 14:30 build took 1,583 s and would have landed after its slot. A late build now fails at the build, not at
         Gate 5. Seconds, not DCA_BUILD_DEADLINE_ET: this one job serves six slots, and a single wall-clock cutoff fits
         only one of them. -->
    <key>DCA_BUILD_DEADLINE_SECONDS</key><string>600</string>
    <!-- Codex workers run at once (2026-11-04, operator: "make the 9:35 go faster"). The launcher's default 3 meant 23
         four-ticker chunks in 8 waves of about 65 s: the newest builds took 507-588 s and the 9:35 run waited about 9
         minutes for its data. 6 workers is 4 waves, about 4.5 minutes, the same as the 3:30 shadow job (the tests keep
         the two equal). Watch the `timing total` lines in /tmp/dca-robinhood-payload.log after the change. -->
    <!-- 2026-11-06: 6 -> 8. The 122-symbol universe is 31 chunks; 6 workers is 6 waves (about 390 s), 8 is 4 waves (about 260 s). -->
    <key>DCA_CODEX_PARALLEL</key><string>8</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- One minute after each Robinhood-primary slot's decision time (09:35 10:30 11:30 12:30 13:30 14:30),
       Mon-Fri. Local Mac time: the Mac must be pinned to America/New_York, or Hour must be shifted by the
       difference; launchd does not understand ET. robinhood_payload.sh auto reads the ET clock itself, so a
       wrong offset makes it skip ("no slot is due") rather than build the wrong slot. The 15:30 slot is
       Finance-primary and not covered. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>31</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/dca-robinhood-payload.log</string>
  <key>StandardErrorPath</key><string>/tmp/dca-robinhood-payload.log</string>
</dict>
