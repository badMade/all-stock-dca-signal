<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.all-stock-dca.schedule-watchdog</string>
  <!-- Daily schedule watchdog (scripts/schedule_watchdog.py): did every live slot leave verified evidence today?
       Independent of the executor sessions. On a failure it writes one idempotent alert file per failing slot
       under <cron root>/schedule_watchdog/alerts AND raises a macOS notification. Started through the checkout's venv Python, like the robinhood-payload agent, because macOS
       privacy protection (TCC) grants ~/Documents access per binary. -->
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_REPO_PATH/.venv/bin/python</string>
    <string>-m</string>
    <string>scripts.schedule_watchdog</string>
    <string>--notify</string>
  </array>
  <!-- `-m scripts.schedule_watchdog` resolves from the checkout root. -->
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPO_PATH</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Must match what the Claude sessions use, or the audit reads a tree no slot writes to. -->
    <key>DCA_CRON_TRACKING_ROOT</key><string>REPLACE_WITH_CRON_TRACKING_ROOT</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- 16:35 Mon-Fri, after the last slot's grace deadline (15:30 slot window ends 16:00, plus 30 minutes grace),
       so no slot can still read "awaiting". Local Mac time: the Mac must be pinned to America/New_York, or Hour
       must be shifted by the difference; launchd does not understand ET. A holiday audits OK (every slot is
       market_closed), so it stays silent. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>35</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/dca-schedule-watchdog.log</string>
  <key>StandardErrorPath</key><string>/tmp/dca-schedule-watchdog.log</string>
</dict>
</plist>
