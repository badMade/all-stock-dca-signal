<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- SHADOW ONLY (2026-10-22). Builds the 3:30 PM Robinhood payload one minute after the 15:30 decision time so its
       duration, coverage and quote freshness can be measured for several days BEFORE the 3:30 slot is moved onto it.
       Nothing reads the file it writes: no live prompt references it and the 3:30 slot is still Finance-primary with
       its Robinhood-only outage fallback. Safe to unload at any time. A separate Label and log keep it from touching
       the six-slot job (com.all-stock-dca.robinhood-payload). Remove it once the 3:30 slot is cut over and `auto`
       covers 1530. See docs/robinhood_payload.md, "The 3:30 PM slot (shadow only)". -->
  <key>Label</key><string>com.all-stock-dca.robinhood-payload-1530-shadow</string>
  <key>ProgramArguments</key>
  <!-- Started through the checkout's venv Python for the same macOS privacy (TCC) reason as the six-slot job.
       The slot is named explicitly: `auto` never selects 1530. -->
  <array>
    <string>REPLACE_WITH_REPO_PATH/.venv/bin/python</string>
    <string>-c</string>
    <string>import subprocess, sys; sys.exit(subprocess.call(["/bin/bash", sys.argv[1], "1530"]))</string>
    <string>REPLACE_WITH_REPO_PATH/deploy/launchd/robinhood_payload.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DCA_REPO</key><string>REPLACE_WITH_REPO_PATH</string>
    <key>DCA_CRON_TRACKING_ROOT</key><string>REPLACE_WITH_CRON_TRACKING_ROOT</string>
    <key>DCA_CODEX_BIN</key><string>REPLACE_WITH_CODEX_PATH</string>
    <!-- Overall build deadline, seconds from the start of the fetch. A real 90-ticker build takes 2-6 minutes (4-ticker
         chunks since 2026-11-02 mean more worker calls); 9 minutes ends a slow build by 15:40 so a payload that cannot be
         ready in time fails at the build, not at Gate 5. 540 s is the most that still ends by the 15:40 cutoff below. -->
    <key>DCA_BUILD_DEADLINE_SECONDS</key><string>540</string>
    <!-- 6 parallel workers (the installed plist already runs 6): 4-ticker chunks mean more worker calls, and at 3 the
         23-chunk rebuild on 2026-11-03 took 519 s. -->
    <key>DCA_CODEX_PARALLEL</key><string>6</string>
    <!-- Wall-clock cutoff, ET (2026-10-30). The live 1530ET prompt re-checks `check` for 12 minutes and then aborts, and
         its session fires at 15:30, so it never gives up before 15:42. 480 s only counts from the build's own start, so a
         job launchd fires late would fetch past that. 15:40 caps the fetch whatever the start, leaving the merge and one
         30-second re-check before 15:42; the earlier of the two deadlines wins. -->
    <key>DCA_BUILD_DEADLINE_ET</key><string>15:40</string>
    <!-- Concurrent Codex workers (2026-11-04). With 4-ticker chunks (#2115) the plan is 23 chunks of about 60 s each;
         the launcher's default 3 workers ran them in 8 waves, 519 s, and the 11-03 payload published at 15:39, too late
         for the 3:30 session to place its 34 candidates. 6 workers is 4 waves, about 4 minutes, ready near 15:35. Only
         this agent sets it: the six live slots keep the default. -->
    <key>DCA_CODEX_PARALLEL</key><string>6</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- 15:31 Mon-Fri, local Mac time (the Mac must be pinned to America/New_York, or Hour shifted by the difference). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/dca-robinhood-payload-1530-shadow.log</string>
  <key>StandardErrorPath</key><string>/tmp/dca-robinhood-payload-1530-shadow.log</string>
</dict>
</plist>
