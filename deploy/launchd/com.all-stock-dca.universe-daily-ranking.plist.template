<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.all-stock-dca.universe-daily-ranking</string>
  <!-- Daily universe job (ticker-advisor/daily_universe_job.py, step 7b-2 of docs/adr-program-maintained-universe.md):
       ranks the pool and, because this agent passes the apply flag, writes a proposal that passed every safeguard
       to this checkout's config/tickers.json and appends the new list to config/ticker_history.csv. It changes the
       buy list only and never sells: a name that leaves the list just stops being considered for new buys. It
       commits nothing and holds no secret. Started through the checkout's venv Python, like the other agents,
       because macOS privacy protection (TCC) grants ~/Documents access per binary.
       Replace REPLACE_WITH_REPO_PATH with this checkout, REPLACE_WITH_SNAPSHOT_FILE with the fundamentals snapshot
       JSON, REPLACE_WITH_PRICE_ARCHIVE_CSV with the price archive CSV, REPLACE_WITH_EXCHANGES_FILE with the exchange
       map JSON, and REPLACE_WITH_OUT_DIR with a directory for the proposal and report. Drop the apply flag for a
       propose-only first run. Exit codes: 0 passed, 1 rejected, 2 bad input, 3 the writer refused. -->
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_REPO_PATH/.venv/bin/python</string>
    <string>REPLACE_WITH_REPO_PATH/ticker-advisor/daily_universe_job.py</string>
    <string>--snapshot</string>
    <string>REPLACE_WITH_SNAPSHOT_FILE</string>
    <string>--prices</string>
    <string>REPLACE_WITH_PRICE_ARCHIVE_CSV</string>
    <string>--tickers-config</string>
    <string>REPLACE_WITH_REPO_PATH/config/tickers.json</string>
    <string>--exchanges</string>
    <string>REPLACE_WITH_EXCHANGES_FILE</string>
    <string>--history</string>
    <string>REPLACE_WITH_REPO_PATH/config/ticker_history.csv</string>
    <string>--out-dir</string>
    <string>REPLACE_WITH_OUT_DIR</string>
    <string>--apply</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPO_PATH/ticker-advisor</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- 19:00 Mon-Fri local time, after the 18:30 archive and snapshot jobs. Local Mac time: pin the Mac to
       America/New_York or shift Hour. If the Mac is asleep launchd runs the job on wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/dca-universe-daily-ranking.log</string>
  <key>StandardErrorPath</key><string>/tmp/dca-universe-daily-ranking.log</string>
</dict>
</plist>
