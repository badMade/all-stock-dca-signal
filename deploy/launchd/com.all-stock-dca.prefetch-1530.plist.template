<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.all-stock-dca.prefetch-1530</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO_PATH/deploy/launchd/prefetch_1530.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DCA_REPO</key><string>REPLACE_WITH_REPO_PATH</string>
    <!-- Must match what the Cowork sessions use, or the file lands where 3:30 never looks. -->
    <key>DCA_CRON_TRACKING_ROOT</key><string>REPLACE_WITH_CRON_TRACKING_ROOT</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Local Mac time. This must run on a host pinned to America/New_York, or the
       operator must adjust Hour/Minute whenever the Mac's local timezone differs
       from ET; launchd does not understand "15:31 ET" natively. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>31</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/dca-prefetch-1530.log</string>
  <key>StandardErrorPath</key><string>/tmp/dca-prefetch-1530.log</string>
</dict>
</plist>
