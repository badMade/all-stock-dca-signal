# DCA drift detector — intraday stream, 14:30 ET slot.
#
# Runs deploy/run-drift-check.sh against the 14:30 intraday run directory
# after the live intraday task writes its artifacts, and fires a Slack alert
# on drift. Paired with dca-drift-intraday-1430.timer. The intraday task
# (7be82b97) fires at three ET slots (11:30, 13:30, 14:30); this unit covers
# only the 14:30 slot -- see dca-drift-intraday-1130 and -1330 for the others.
# See the script's header comment for the full rationale (it also documents
# why this logic is NOT inlined directly in ExecStart= below: systemd expands
# every "$" in an ExecStart= command line against its own environment before
# handing it to a shell, so single quotes there do not protect $-variables
# and $(...) the way they would in a real shell -- codex review on commit
# b85d39e).
#
# WorkingDirectory and ExecStart paths are parametrized via the REPO_ROOT
# environment variable, sourced from /etc/all-stock-dca.env (or
# ~/.config/all-stock-dca.env for user-local installs). Before deploying,
# create that file with REPO_ROOT=/path/to/all-stock-dca and restrict
# permissions to 0600 (see docs/slack_webhook_injection.md for setup details).
# The script itself sources deploy/drift-slack.env (copy
# deploy/drift-slack.env.example to it, chmod 600, first).
#
# Runs as the dedicated dca-drift service user/group rather than root -- see
# docs/slack_webhook_injection.md for how to create that account (with a
# same-named group) and grant it read access to the checkout plus WRITE
# access to the run directories the detector reports into. Running these
# units as root would let anyone who can modify the checkout gain root code
# execution at the next timer firing (codex review discussion_r3697106550).
#
# Added to cover the intraday live stream, which previously had no
# independently scheduled backup check (codex review discussion_r3697106535).

[Unit]
Description=DCA drift detector (intraday 14:30 ET)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dca-drift
Group=dca-drift
EnvironmentFile=-/etc/all-stock-dca.env
ExecStart=/bin/sh -c 'exec ${REPO_ROOT}/deploy/run-drift-check.sh intraday_dca 1430ET'
