# Template for the operator's LOCAL .env (copy to .env, then: chmod 600 .env).
# .env is gitignored; this template holds placeholders only. dca_env.py loads these
# three names when dca_paths is imported; a variable already exported in the shell
# wins over this file. Put comments on their own line, not after a value.

# The live Robinhood Agentic account number (digits). Never commit the real value.
ROBINHOOD_AGENTIC_ACCOUNT_NUMBER=
# Where gate alerts are emailed.
DCA_ALERT_EMAIL_ADDRESS=
# Optional: only set to relocate the artifact tree (defaults to ./cron_tracking).
# DCA_CRON_TRACKING_ROOT=
